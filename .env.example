# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql+psycopg://localetl:localetl@127.0.0.1:5432/localetl
TEST_DATABASE_URL=postgresql+psycopg://localetl:localetl@127.0.0.1:5432/localetl_test

LOCALETL_DATA_DIR=./data
LOCALETL_MAX_UPLOAD_MB=100
LOCALETL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOCALETL_CHUNK_ROWS=50000

WORKER_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=10
WORKER_STALE_AFTER_SECONDS=60

VITE_API_URL=http://127.0.0.1:8000/api/v1

# docker-compose only
# Host port for the db container. If another Postgres already uses 5432 (e.g. Postgres.app),
# set 55432 here AND change the port in DATABASE_URL / TEST_DATABASE_URL above.
POSTGRES_PORT=5432
POSTGRES_USER=localetl
POSTGRES_PASSWORD=localetl
POSTGRES_DB=localetl
