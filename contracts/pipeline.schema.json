{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localetl.local/contracts/pipeline.schema.json",
  "title": "PipelineConfig",
  "description": "LocalETL pipeline configuration, version 1. Stages run in fixed order: extract -> transform (column mapping and casting, then transformations in array order) -> validate -> load -> publish. Semantic rules not expressible here are listed in docs/architecture.md section 6.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "columns",
    "target"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/ColumnMapping"
      }
    },
    "transformations": {
      "type": "array",
      "maxItems": 100,
      "default": [],
      "items": {
        "$ref": "#/$defs/Transformation"
      }
    },
    "validations": {
      "type": "array",
      "maxItems": 200,
      "default": [],
      "items": {
        "$ref": "#/$defs/Validation"
      }
    },
    "on_validation_failure": {
      "enum": [
        "reject_row",
        "fail_run"
      ],
      "default": "reject_row"
    },
    "max_rejected_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1,
      "description": "Maximum rejected_count / extracted_count before the run fails and nothing is published. Rows removed by deduplicate or drop_null_rows are not rejections; they count in the denominator only."
    },
    "target": {
      "$ref": "#/$defs/Target"
    }
  },
  "$defs": {
    "Identifier": {
      "description": "Target table or column name. Validated by this pattern and always quoted by SQLAlchemy.",
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]{0,62}$"
    },
    "SourceColumnName": {
      "description": "A CSV header exactly as it appears in the file. Never used in SQL.",
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "ColumnType": {
      "enum": [
        "integer",
        "float",
        "boolean",
        "date",
        "datetime",
        "string"
      ]
    },
    "CsvOptions": {
      "description": "How a data source's CSV file is parsed. Set at upload and stored on the data source, not in the pipeline config. Defined here so the OpenAPI contract and the engine share one definition.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "encoding": {
          "enum": [
            "utf-8",
            "utf-8-sig",
            "latin-1",
            "cp1252"
          ],
          "default": "utf-8"
        },
        "delimiter": {
          "enum": [
            ",",
            ";",
            "\t",
            "|"
          ],
          "default": ","
        },
        "has_header": {
          "type": "boolean",
          "default": true
        },
        "quote_char": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "default": "\""
        }
      }
    },
    "ColumnMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "name",
        "type"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceColumnName"
        },
        "name": {
          "$ref": "#/$defs/Identifier"
        },
        "type": {
          "$ref": "#/$defs/ColumnType"
        },
        "format": {
          "description": "strptime format for date/datetime columns, e.g. %Y-%m-%d. Ignored for other types.",
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "nullable": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "ColumnList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Identifier"
      }
    },
    "ScalarValue": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "Transformation": {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "trim_whitespace",
            "change_case",
            "replace_values",
            "fill_null",
            "drop_null_rows",
            "deduplicate",
            "round_number"
          ]
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TrimWhitespace"
        },
        {
          "$ref": "#/$defs/ChangeCase"
        },
        {
          "$ref": "#/$defs/ReplaceValues"
        },
        {
          "$ref": "#/$defs/FillNull"
        },
        {
          "$ref": "#/$defs/DropNullRows"
        },
        {
          "$ref": "#/$defs/Deduplicate"
        },
        {
          "$ref": "#/$defs/RoundNumber"
        }
      ]
    },
    "TrimWhitespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "columns"
      ],
      "properties": {
        "op": {
          "const": "trim_whitespace"
        },
        "columns": {
          "$ref": "#/$defs/ColumnList"
        }
      }
    },
    "ChangeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "columns",
        "case"
      ],
      "properties": {
        "op": {
          "const": "change_case"
        },
        "columns": {
          "$ref": "#/$defs/ColumnList"
        },
        "case": {
          "enum": [
            "lower",
            "upper",
            "title"
          ]
        }
      }
    },
    "ReplaceValues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "column",
        "mapping"
      ],
      "properties": {
        "op": {
          "const": "replace_values"
        },
        "column": {
          "$ref": "#/$defs/Identifier"
        },
        "mapping": {
          "description": "Exact-match replacements: key is the current value rendered as a string, value is the replacement.",
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1000,
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/ScalarValue"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "FillNull": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "column",
        "value"
      ],
      "properties": {
        "op": {
          "const": "fill_null"
        },
        "column": {
          "$ref": "#/$defs/Identifier"
        },
        "value": {
          "$ref": "#/$defs/ScalarValue"
        }
      }
    },
    "DropNullRows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "columns"
      ],
      "properties": {
        "op": {
          "const": "drop_null_rows"
        },
        "columns": {
          "$ref": "#/$defs/ColumnList"
        },
        "how": {
          "enum": [
            "any",
            "all"
          ],
          "default": "any"
        }
      }
    },
    "Deduplicate": {
      "description": "Drops rows whose key (the listed columns, or all columns when omitted) was already seen earlier in the file; the first occurrence is kept. Applied across chunks.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "const": "deduplicate"
        },
        "columns": {
          "$ref": "#/$defs/ColumnList"
        }
      }
    },
    "RoundNumber": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "column",
        "decimals"
      ],
      "properties": {
        "op": {
          "const": "round_number"
        },
        "column": {
          "$ref": "#/$defs/Identifier"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "Validation": {
      "type": "object",
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "enum": [
            "not_null",
            "unique",
            "range",
            "allowed_values",
            "regex",
            "length"
          ]
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NotNull"
        },
        {
          "$ref": "#/$defs/Unique"
        },
        {
          "$ref": "#/$defs/Range"
        },
        {
          "$ref": "#/$defs/AllowedValues"
        },
        {
          "$ref": "#/$defs/Regex"
        },
        {
          "$ref": "#/$defs/Length"
        }
      ]
    },
    "NotNull": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "column"
      ],
      "properties": {
        "rule": {
          "const": "not_null"
        },
        "column": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "Unique": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "columns"
      ],
      "properties": {
        "rule": {
          "const": "unique"
        },
        "columns": {
          "$ref": "#/$defs/ColumnList"
        }
      }
    },
    "Range": {
      "description": "Inclusive bounds. Numbers for integer/float columns; ISO 8601 strings for date/datetime columns.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "column"
      ],
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        }
      ],
      "properties": {
        "rule": {
          "const": "range"
        },
        "column": {
          "$ref": "#/$defs/Identifier"
        },
        "min": {
          "type": [
            "number",
            "string"
          ]
        },
        "max": {
          "type": [
            "number",
            "string"
          ]
        }
      }
    },
    "AllowedValues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "column",
        "values"
      ],
      "properties": {
        "rule": {
          "const": "allowed_values"
        },
        "column": {
          "$ref": "#/$defs/Identifier"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ScalarValue"
          }
        }
      }
    },
    "Regex": {
      "description": "Python re.fullmatch against string values. Pattern length is capped to limit catastrophic backtracking; values longer than 10,000 characters are rejected without matching.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "column",
        "pattern"
      ],
      "properties": {
        "rule": {
          "const": "regex"
        },
        "column": {
          "$ref": "#/$defs/Identifier"
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "Length": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "column"
      ],
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        }
      ],
      "properties": {
        "rule": {
          "const": "length"
        },
        "column": {
          "$ref": "#/$defs/Identifier"
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table",
        "mode"
      ],
      "properties": {
        "table": {
          "$ref": "#/$defs/Identifier"
        },
        "mode": {
          "enum": [
            "replace",
            "append"
          ]
        }
      }
    }
  }
}
